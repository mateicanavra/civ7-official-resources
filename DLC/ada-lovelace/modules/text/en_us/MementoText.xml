<Database>
	<EnglishText>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PUNCH_CARDS_UNLOCK_TITLE">
			<Text>Unlock at Ada Lovelace level 2</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PIANO_UNLOCK_TITLE">
			<Text>Unlock at Ada Lovelace level 5</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_NOTE_G_UNLOCK_TITLE">
			<Text>Unlock at Ada Lovelace level 9</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PUNCH_CARDS_NAME">
			<Text>Punch Cards</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PUNCH_CARDS_DESCRIPTION">
			<Text>From loom to computer.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PUNCH_CARDS_FUNCTIONAL_DESCRIPTION">
			<Text>Gain [B]20 [icon:YIELD_SCIENCE][/B] per [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP] for every [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Science Building[/TIP] constructed.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PIANO_NAME">
			<Text>Piano</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PIANO_DESCRIPTION">
			<Text>Merging music and math.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_PIANO_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+10% [icon:YIELD_CULTURE][/B] towards studying [TIP:LOC_PEDIA_CONCEPTS_MASTERY_TOOLTIP]Civic Masteries[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_NOTE_G_NAME">
			<Text>Note G</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_NOTE_G_DESCRIPTION">
			<Text>Vision of the future.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ADA_LOVELACE_NOTE_G_FUNCTIONAL_DESCRIPTION">
			<Text>Every time you research a [TIP:LOC_PEDIA_CONCEPTS_TECH_TOOLTIP]Technology[/TIP] or [TIP:LOC_PEDIA_CONCEPTS_MASTERY_TOOLTIP]Civic Mastery[/TIP], the [icon:NOTIFICATION_SELECT_CAPITAL] [TIP:LOC_PEDIA_CONCEPTS_CAPITAL_TOOLTIP]Capital[/TIP] gains [icon:YIELD_PRODUCTION] equal to 15% of its cost.</Text>
		</Row>
	</EnglishText>
</Database>