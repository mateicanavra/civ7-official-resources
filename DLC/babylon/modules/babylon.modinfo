<?xml version="1.0" encoding="utf-8"?>
<Mod id="babylon" version="1"
	xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_BABYLON_NAME</Name>
		<Description>LOC_MODULE_BABYLON_DESCRIPTION</Description>
		<Authors>LOC_AUTHORS_FIRAXIS</Authors>
		<EnabledByDefault>1</EnabledByDefault>
		<Package>Echidna</Package>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<References>
		<Mod id="gilgamesh" title="LOC_MODULE_GILGAMESH_NAME" />
	</References>
	<ActionCriteria>
		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="antiquity-age-persist" any="true">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<Criteria id="gilgamesh-current">
			<ModInUse>gilgamesh</ModInUse>
		</Criteria>
		<Criteria id="gilgamesh-current-shell">
			<ModInUse>gilgamesh</ModInUse>
		</Criteria>
		<Criteria id="ottomans-current">
			<ModInUse>ottomans</ModInUse>
		</Criteria>
		<Criteria id="ottomans-current-shell">
			<ModInUse>ottomans</ModInUse>
		</Criteria>
		<Criteria id="qajar-current">
			<ModInUse>qajar</ModInUse>
		</Criteria>
		<Criteria id="qajar-current-shell">
			<ModInUse>qajar</ModInUse>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="babylon-art" scope="game" criteria="always">
			<Actions>
				<UpdateArt>
					<Item>babylon-shell</Item>
					<Item>babylon</Item>
				</UpdateArt>
				<UpdateIcons>
					<Item>data/icons/icons.xml</Item>
				</UpdateIcons>
			</Actions>
		</ActionGroup>
		<ActionGroup id="babylon-movies" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/movies.xml</Item>
				</UpdateDatabase>
				<ImportFiles locale="de_DE">
					<Item>l10n/de_DE/loading_civ_antiquity_babylon.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="es_ES">
					<Item>l10n/es_ES/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="fr_FR">
					<Item>l10n/fr_FR/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="it_IT">
					<Item>l10n/it_IT/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="ja_JP">
					<Item>l10n/ja_JP/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="ko_KR">
					<Item>l10n/ko_KR/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="pl_PL">
					<Item>l10n/pl_PL/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="pt_BR">
					<Item>l10n/pt_BR/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="ru_RU">
					<Item>l10n/ru_RU/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="zh_Hans_CN">
					<Item>l10n/zh_Hans_CN/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>

				<ImportFiles locale="zh_Hant_HK">
					<Item>l10n/zh_Hant_HK/wilco_civ_antiquity_babylon_defeat.vtt</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<ActionGroup id="babylon-text" scope="game" criteria="always">
			<Actions>
				<UpdateText>
					<Item>text/en_us/CitizenNamesText.xml</Item>
					<Item>text/en_us/CityNamesText.xml</Item>
					<Item>text/en_us/CivilizationLegacyText.xml</Item>
					<Item>text/en_us/CivilizationText.xml</Item>
					<Item>text/en_us/CivilopediaText.xml</Item>
					<Item>text/en_us/ConstructibleText.xml</Item>
					<Item>text/en_us/CultureText.xml</Item>
					<Item>text/en_us/GreatWorksText.xml</Item>
					<Item>text/en_us/LoadingText.xml</Item>
					<Item>text/en_us/MetaprogressionText.generated.xml</Item>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item>text/en_us/NamedPlacesText.xml</Item>
					<Item>text/en_us/NarrativeStoriesText.xml</Item>
					<Item>text/en_us/UnitText.xml</Item>
					<Item>text/en_us/UnlockText.xml</Item>

					<!-- Items below were generated via our loc tool. -->
					<Item>l10n/ModuleText.xml</Item>
					<Item locale="de_DE">l10n/de_DE_Text.xml</Item>
					<Item locale="es_ES">l10n/es_ES_Text.xml</Item>
					<Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
					<Item locale="it_IT">l10n/it_IT_Text.xml</Item>
					<Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
					<Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
					<Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
					<Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
					<Item locale="ru_RU">l10n/ru_RU_Text.xml</Item>
					<Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
					<Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-babylon" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-legacy.xml</Item>
					<Item>data/civilizations-shared.xml</Item>
					<Item>data/civilizations-shared-gameeffects.xml</Item>
					<Item>data/loading-info-antiquity.xml</Item>
					<Item>data/citizen-names.xml</Item>
					<Item>data/metaprogression.xml</Item>
					<Item>data/metaprogression-gameeffects.xml</Item>
					<Item>data/named-places.xml</Item>
					<Item>data/narrative-stories.xml</Item>
					<Item>data/narrative-stories-common-gameeffects.xml</Item>
					<Item>data/narrative-stories-gameeffects.xml</Item>
					<Item>data/traditions.xml</Item>
					<Item>data/traditions-gameeffects.xml</Item>
					<Item>data/unlocks-base-standard.xml</Item>
					<Item>data/unlocks-antiquity.xml</Item>
					<Item>data/unlocks-syncretism.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-babylon-gilgamesh" scope="game" criteria="gilgamesh-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-gilgamesh.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-babylon-ottomans" scope="game" criteria="ottomans-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/unlocks-ottomans.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-babylon-qajar" scope="game" criteria="qajar-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/unlocks-qajar.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-antiquity-main-babylon" scope="game" criteria="antiquity-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-antiquity.xml</Item>
					<Item>data/civilizations-gameeffects.xml</Item>
					<Item>data/greatworks.xml</Item>
					<Item>data/narrative-display.xml</Item>
					<Item>data/narrative-stories-gameeffects-antiquity.xml</Item>
					<Item>data/narrative-stories-antiquity.xml</Item>
					<Item>data/progression-trees-culture-unique.xml</Item>
					<Item>data/progression-trees-culture-unique-gameeffects.xml</Item>
					<Item>data/progression-trees-tech.xml</Item>
					<Item>data/units.xml</Item>
					<Item>data/units-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-antiquity-persist-babylon" scope="game" criteria="antiquity-age-persist">
			<Actions>
				<UpdateDatabase>
					<Item>data/constructibles.xml</Item>
					<Item>data/constructibles-gameeffects.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-exploration-main-babylon" scope="game" criteria="exploration-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/remove-data-ex.xml</Item>
					<Item>data/civilizations-exploration.xml</Item>
					<Item>data/civilizations-gameeffects-ex.xml</Item>
					<Item>data/narrative-stories-gameeffects-exploration.xml</Item>
					<Item>data/narrative-stories-exploration.xml</Item>
					<Item>data/progression-trees-culture-unique-ex.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-modern-main-babylon" scope="game" criteria="modern-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/remove-data-mo.xml</Item>
					<Item>data/civilizations-modern.xml</Item>
					<Item>data/civilizations-gameeffects-mo.xml</Item>
					<Item>data/narrative-stories-gameeffects-modern.xml</Item>
					<Item>data/narrative-stories-modern.xml</Item>
					<Item>data/progression-trees-culture-unique-mo.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="shell-babylon-gilgamesh" scope="shell" criteria="gilgamesh-current-shell">
			<Actions>
				<UpdateDatabase>
					<Item>config/config-gilgamesh.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="shell-babylon-qajar" scope="shell" criteria="qajar-current-shell">
			<Actions>
				<UpdateDatabase>
					<Item>config/config-qajar.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="shell-babylon-ottomans" scope="shell" criteria="ottomans-current-shell">
			<Actions>
				<UpdateDatabase>
					<Item>config/config-ottomans.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="shell-babylon" scope="shell" criteria="always">
			<Actions>
				<UpdateArt>
					<Item>babylon-shell</Item>
				</UpdateArt>
				<UpdateIcons>
					<Item>data/icons/icons.xml</Item>
				</UpdateIcons>
				<UpdateDatabase>
					<Item>config/config.xml</Item>
					<Item>config/metaprogression.xml</Item>
					<Item>config/config-traditions.xml</Item>
					<Item>data/unlocks-syncretism.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/CivilizationLegacyText.xml</Item>
					<Item>text/en_us/CivilizationText.xml</Item>
					<Item>text/en_us/CultureText.xml</Item>
					<Item>text/en_us/ConstructibleText.xml</Item>
					<Item>text/en_us/LoadingText.xml</Item>
					<Item>text/en_us/MetaprogressionText.generated.xml</Item>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item>text/en_us/UnitText.xml</Item>
					<Item>text/en_us/UnlockText.xml</Item>

					<!-- Items below were generated via our loc tool. -->
					<Item>l10n/ModuleText.xml</Item>
					<Item locale="de_DE">l10n/de_DE_Text.xml</Item>
					<Item locale="es_ES">l10n/es_ES_Text.xml</Item>
					<Item locale="fr_FR">l10n/fr_FR_Text.xml</Item>
					<Item locale="it_IT">l10n/it_IT_Text.xml</Item>
					<Item locale="ja_JP">l10n/ja_JP_Text.xml</Item>
					<Item locale="ko_KR">l10n/ko_KR_Text.xml</Item>
					<Item locale="pl_PL">l10n/pl_PL_Text.xml</Item>
					<Item locale="pt_BR">l10n/pt_BR_Text.xml</Item>
					<Item locale="ru_RU">l10n/ru_RU_Text.xml</Item>
					<Item locale="zh_Hans_CN">l10n/zh_Hans_CN_Text.xml</Item>
					<Item locale="zh_Hant_HK">l10n/zh_Hant_HK_Text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
		<File>l10n/ModuleText.xml</File>
	</LocalizedText>
</Mod>