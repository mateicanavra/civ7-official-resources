	<EnglishText>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_NIMCHA_NAME">
			<Text>Nimcha</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_NIMCHA_DESCRIPTION">
			<Text>A blade for land and ship.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_NIMCHA_FUNCTIONAL_DESCRIPTION">
			<Text>[B]-1 [icon:YIELD_GOLD][/B] [TIP:LOC_PEDIA_CONCEPTS_MAINTENANCE_TOOLTIP]Maintenance[/TIP] on [TIP:LOC_PEDIA_CONCEPTS_NAVAL_UNITS_TOOLTIP]Naval Units[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_MITHQAL_NAME">
			<Text>Mithqāl</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_MITHQAL_DESCRIPTION">
			<Text>The weight of currency.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_MITHQAL_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+2 [icon:YIELD_GOLD][/B] per [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP] in [TIP:LOC_PEDIA_CONCEPTS_SETTLEMENT_TOOLTIP]Settlements[/TIP] with a Naval Unit [TIP:LOC_PEDIA_CONCEPTS_STATIONED_TOOLTIP]Stationed[/TIP] on a [icon:CITY_URBAN] [TIP:LOC_PEDIA_CONCEPTS_DISTRICT_TOOLTIP]District[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_GAZELLE_VASE_NAME">
			<Text>Gazelle Vase</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_GAZELLE_VASE_DESCRIPTION">
			<Text>Granadan artistry.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_SAYYIDA_AL_HURRA_GAZELLE_VASE_FUNCTIONAL_DESCRIPTION">
			<Text>Gain [B]25 [icon:YIELD_CULTURE][/B] per [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP] for every Diplomatic Action accepted by another Leader.</Text>
		</Row>
