	<!-- NEPAL -->
	<Modifier id="MOD_NEPAL_IMPROVE_MOUNTAINS" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_CONSTRUCTIBLE_UNLOCK">
		<!-- The Incans are base game, so just reusing the same faux improvement. -->
		<Argument name="ConstructibleType">IMPROVEMENT_INCA_MOUNTAIN</Argument>
	</Modifier>
	<Modifier id="MOD_NEPAL_MOUNTAIN_WAREHOUSES" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ACTIVATE_CONSTRUCTIBLE_WAREHOUSE_YIELD">
		<Argument name="ConstructibleWarehouseYield">NepalBrickyardMountainProduction, NepalFishingQuayMountainFood, NepalHarborMountainProduction, NepalGranaryMountainFood, NepalSawPitMountainProduction, NepalGristmillMountainFood, NepalSawmillMountainProduction, NepalStonecutterMountainProduction, NepalGrocerMountainFood, NepalIronworksMountainProduction
		</Argument>
	</Modifier>
	<Modifier id="MOD_EXPENSIVE_WAREHOUSE_BUILDINGS" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_SPECIFIC_CONSTRUCTIBLE_MAINTENANCE">
		<Argument name="Tag">WAREHOUSE</Argument>
		<Argument name="YieldType">YIELD_HAPPINESS, YIELD_GOLD</Argument>
		<Argument name="Amount">1, 1</Argument>
		<Argument name="Tooltip">LOC_TRAIT_NEPAL_ABILITY_NAME</Argument>
	</Modifier>
</GameEffects>