		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_EXPLORATION_1_NAME">
			<Text>Exploration Diplomatic Dedication</Text>
		</Row>
		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_EXPLORATION_1_DESCRIPTION">
			<Text>As George Washington, access a new Exploration Dedication:[n]
