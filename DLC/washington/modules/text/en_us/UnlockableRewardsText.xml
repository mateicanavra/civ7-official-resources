		</Row>
		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_EXPLORATION_2_NAME">
			<Text>Exploration Expansionist Dedication</Text>
		</Row>
		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_EXPLORATION_2_DESCRIPTION">
			<Text>As George Washington, access a new Exploration Dedication:[n]
				+15% Food, -10% Gold</Text>
		</Row>
		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_MODERN_1_NAME">
			<Text>Modern Diplomatic Dedication</Text>
		</Row>
		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_MODERN_1_DESCRIPTION">
			<Text>As George Washington, access a new Modern Dedication:[n]
				+15% Influence, -2 Combat Strength for Air Units</Text>
		</Row>
		<Row Tag="LOC_STRATEGYCARD_WASHINGTON_MODERN_2_NAME">
			<Text>Modern Expansionist Dedication</Text>
		</Row>
