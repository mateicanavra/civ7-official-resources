<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- +2 Combat Strength for Land Units base-->
	<Modifier id="ALEXANDER_COMBAT_BONUS_BASE" collection="COLLECTION_PLAYER_UNITS" effect="EFFECT_ATTACH_MODIFIERS">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_UNIT_DOMAIN_MATCHES">
				<Argument name="UnitDomain">DOMAIN_LAND</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ModifierId">ALEXANDER_COMBAT_BONUS_BASE_ATTACH</Argument>
	</Modifier>
	<Modifier id="ALEXANDER_COMBAT_BONUS_BASE_ATTACH" collection="COLLECTION_UNIT_COMBAT" effect="EFFECT_ADJUST_UNIT_STRENGTH_MODIFIER">
		<Argument name="Amount">2</Argument>
		<String context="Preview">LOC_ALEXANDER_KING_OF_THE_WORLD_SUZERAIN_PREVIEW</String>
	</Modifier>
	<!-- ALEX_TO_DO +1 Combat Strength for Unique Units for each Non-Capital City with a Wonder -->

	<!-- Non-Capital Cities with a Wonder get +10% Production and Culture, doubled if they are on a different Continent than your Capital. -->
	<Modifier id="ALEXANDER_YIELD_BONUS_WITH_WONDER_CAPITAL_CONT" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_HAS_ANY_WONDER"/>
			<Requirement type="REQUIREMENT_CITY_IS_CITY"/>
			<Requirement type="REQUIREMENT_CITY_IS_CAPITAL" inverse="true"/>
			<Requirement type="REQUIREMENT_CITY_IS_OWNER_CAPITAL_CONTINENT"/>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_CULTURE, YIELD_PRODUCTION</Argument>
		<Argument name="Percent">10</Argument>
		<Argument name="Tooltip">LOC_ALEXANDER_KING_OF_THE_WORLD_NAME</Argument>
	</Modifier>
	<Modifier id="ALEXANDER_YIELD_BONUS_WITH_WONDER_NOT_CAPITAL_CONT" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_HAS_ANY_WONDER"/>
			<Requirement type="REQUIREMENT_CITY_IS_CITY"/>
			<Requirement type="REQUIREMENT_CITY_IS_CAPITAL" inverse="true"/>
			<Requirement type="REQUIREMENT_CITY_IS_OWNER_CAPITAL_CONTINENT" inverse="true"/>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_CULTURE, YIELD_PRODUCTION</Argument>
		<Argument name="Percent">20</Argument>
		<Argument name="Tooltip">LOC_ALEXANDER_KING_OF_THE_WORLD_NAME</Argument>
	</Modifier>

