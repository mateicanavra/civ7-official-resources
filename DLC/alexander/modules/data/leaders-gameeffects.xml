	<!-- +2 Dominion for each Non-Capital City with a Wonder -->
	<Modifier id="ALEXANDER_MOD_SETTLEMENT_MILITARY_VICTORY" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ACTIVATE_VICTORY_POINT_TRACKER" run-once="true" permanent="true">
		<Argument name="TrackerName">VICTORY_TRACKER_SETTLEMENT_ALEXANDER</Argument>
	</Modifier>
	<!-- Towns converted into Cities are renamed after Alexander. -->
	<Modifier id="ALEXANDER_MOD_ALEXANDRIA_RENAME" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_RENAME">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_TOWN_WAS_UPGRADED_TO_CITY"/>
		</SubjectRequirements>
		<Argument name="Rename">LOC_ALEXANDER_ALEXANDRIA_RENAME</Argument>
		<Argument name="AppendtoRename">true</Argument>
	</Modifier>
	<!-- Godlike Basileus Agenda:  Likes Leaders with the fewest conquered Settlements. Dislikes Leaders with the most conquered Settlements. -->
	<Modifier id="ALEXANDER_MOD_AGENDA_GODLIKE_BASILEUS" collection="COLLECTION_OWNER" effect="EFFECT_DIPLOMACY_AGENDA_TIMED_UPDATE">
		<String context="Name">LOC_DIPLOMACY_AGENDA_GODLIKE_BASILEUS_NAME</String>
		<Argument name="ModName">LOC_DIPLOMACY_AGENDA_GODLIKE_BASILEUS_NAME</Argument>
		<Argument name="Tooltip">LOC_DIPLOMACY_AGENDA_GODLIKE_BASILEUS_DESC</Argument>
		<Argument name="WeightType">DIPLOMACY_AGENDA_COMPARE_NUM_CONQUERED_SETTLEMENTS</Argument>
		<Argument name="FirstMeetDelay">20</Argument>
		<Argument name="UpdateFreq">10</Argument>
		<Argument name="AwardTo1">DIPLOMACY_AGENDA_AWARD_HIGHEST</Argument>
		<Argument name="AwardAmtType1">DIPLOMACY_AGENDA_NEG_AMT_MEDIUM</Argument>
		<Argument name="AwardTo2">DIPLOMACY_AGENDA_AWARD_LOWEST</Argument>
		<Argument name="AwardAmtType2">DIPLOMACY_AGENDA_AMT_SMALL</Argument>
		<Argument name="NotifyMessage">LOC_NOTIFICATION_DIPLOMATIC_AGENDA_DEFAULT_MESSAGE</Argument>
		<Argument name="NotifySummary">LOC_NOTIFICATION_DIPLOMATIC_AGENDA_DEFAULT_SUMMARY</Argument>
	</Modifier>
