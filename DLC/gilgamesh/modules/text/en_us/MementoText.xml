<Database>
	<EnglishText>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MAGIC_PLANT_NAME">
			<Text>Magic Plant</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MAGIC_PLANT_DESCRIPTION">
			<Text>The key to immortality.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MAGIC_PLANT_FUNCTIONAL_DESCRIPTION">
			<Text>Friendly greetings give [B]+100% [icon:RELATIONSHIP][/B] [TIP:LOC_PEDIA_CONCEPTS_RELATIONSHIP_TOOLTIP]Relationship[/TIP] increase.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_PUKKU_NAME">
			<Text>Pukku</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_PUKKU_DESCRIPTION">
			<Text>Once loved, once lost.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_PUKKU_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+2 [icon:YIELD_HAPPINESS][/B] in all [TIP:LOC_PEDIA_CONCEPTS_SETTLEMENT_TOOLTIP]Settlements[/TIP] while you have exactly one [icon:PLAYER_RELATIONSHIP_ALLIANCE] [TIP:LOC_PEDIA_CONCEPTS_ALLIANCE_TOOLTIP]Ally[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MIKKU_NAME">
			<Text>Mikku</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MIKKU_DESCRIPTION">
			<Text>Inanna's gift.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MIKKU_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+1 [icon:YIELD_DIPLOMACY][/B] in all [TIP:LOC_PEDIA_CONCEPTS_SETTLEMENT_TOOLTIP]Settlements[/TIP] while you have exactly one [icon:PLAYER_RELATIONSHIP_ALLIANCE] [TIP:LOC_PEDIA_CONCEPTS_ALLIANCE_TOOLTIP]Ally[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MAGIC_PLANT_UNLOCK_TITLE">
			<Text>Unlock at Gilgamesh level 2</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_PUKKU_UNLOCK_TITLE">
			<Text>Unlock at Gilgamesh level 5</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_GILGAMESH_MIKKU_UNLOCK_TITLE">
			<Text>Unlock at Gilgamesh level 9</Text>
		</Row>
	</EnglishText>
