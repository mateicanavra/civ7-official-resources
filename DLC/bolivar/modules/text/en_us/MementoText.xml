<Database>
	<EnglishText>
		<Row Tag="LOC_MEMENTO_BOLIVAR_GOLD_SNUFF_BOX_NAME">
			<Text>Gold Snuff Box</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_GOLD_SNUFF_BOX_DESCRIPTION">
			<Text>Gift from a royal.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_GOLD_SNUFF_BOX_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+20 [icon:YIELD_FOOD][/B] per [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP] in Cities when in only one [icon:PLAYER_RELATIONSHIP_ALLIANCE] [TIP:LOC_PEDIA_CONCEPTS_ALLIANCE_TOOLTIP]Alliance[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_DAVALOS_MEDAL_NAME">
			<Text>Davalos Medal</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_DAVALOS_MEDAL_DESCRIPTION">
			<Text>Legacy of Ayacucho.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_DAVALOS_MEDAL_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+1 [icon:YIELD_HAPPINESS][/B] per [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP] on [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Military Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_LETTER_TO_JAMAICA_NAME">
			<Text>Letter to Jamaica</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_LETTER_TO_JAMAICA_DESCRIPTION">
			<Text>Vision of the future.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_LETTER_TO_JAMAICA_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+50% [icon:YIELD_GOLD][/B] towards purchasing Units during a [icon:CELEBRATION] [TIP:LOC_PEDIA_CONCEPTS_CELEBRATIONS_TOOLTIP]Celebration[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_GOLD_SNUFF_BOX_UNLOCK_TITLE">
			<Text>Unlock at Simón Bolívar level 2</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_DAVALOS_MEDAL_UNLOCK_TITLE">
			<Text>Unlock at Simón Bolívar level 5</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_BOLIVAR_LETTER_TO_JAMAICA_UNLOCK_TITLE">
			<Text>Unlock at Simón Bolívar level 9</Text>
		</Row>
	</EnglishText>
