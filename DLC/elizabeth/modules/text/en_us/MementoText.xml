		<Row Tag="LOC_MEMENTO_ELIZABETH_JUELLES_OF_GOLDE_NAME">
			<Text>Juelles of Golde</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ELIZABETH_JUELLES_OF_GOLDE_DESCRIPTION">
			<Text>To crown a queene.</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ELIZABETH_JUELLES_OF_GOLDE_FUNCTIONAL_DESCRIPTION">
			<Text>[B]+1 [icon:YIELD_GOLD][/B] Per [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP] on Displayed [icon:GREATWORK] [TIP:LOC_PEDIA_CONCEPTS_GREAT_WORKS_TOOLTIP]Great Works[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MEMENTO_ELIZABETH_THE_ANNALS_NAME">
