<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- ==================================================	-->
	<!--				Civ-Specific Traits					-->
	<!-- ==================================================	-->
	<Modifier id="MOD_CIV_DOUBLE_MERCHANTS" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_UNIT_EXTRA_COPY">
		<Argument name="Tag">UNIT_CLASS_MAKE_TRADE_ROUTE</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="PurchaseValid">true</Argument>
	</Modifier>
	<Modifier id="MOD_CIV_DOUBLE_COLONISTS" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_UNIT_EXTRA_COPY">
		<Argument name="Tag">UNIT_CLASS_CREATE_TOWN</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="PurchaseValid">true</Argument>
	</Modifier>
	<Modifier id="MOD_TOWN_WATER_BUILDING" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_ADJUST_TOWN_CAN_PURCHASE_TAGGED_CONSTRUCTIBLES">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_IS_TOWN"/>
		</SubjectRequirements>
		<Argument name="ConstructibleTag">WATER</Argument>
	</Modifier>
	<Modifier id="MOD_FORBID_CITIES_FROM_TOWNS" collection="COLLECTION_OWNER" effect="EFFECT_ADJUST_CITY_LIMIT" permanent="true">
		<Argument name="Amount">1</Argument>
	</Modifier>
	<Modifier id="TRAIT_MOD_COLONIST_POP" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_POPULATION" permanent="true">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_FOUNDED_BY_UNIT_TYPE">
				<Argument name="UnitType">UNIT_COLONIST</Argument>
			</Requirement>
			<Requirement type="REQUIREMENT_PLOT_ADJACENT_RESOURCE_CLASS_TYPE_MATCHES"/>
		</SubjectRequirements>
		<Argument name="Amount">1</Argument>
	</Modifier>
</GameEffects>