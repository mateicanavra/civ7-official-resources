<?xml version="1.0" encoding="utf-8"?>
<Database>
    <EnglishText>
        <Row Tag="LOC_10185A_STORYTITLE">
            <Text>The Good Doctor and All Things {1_SUBJECT_CIVILIZATION_ADJ}</Text>
        </Row>
        <Row Tag="LOC_10185A_COMPLETION">
            <Text>To Dr Rizal, the {1_SUBJECT_CIVILIZATION_ADJ} capital is nothing so much as a sprawling labyrinth, or a puzzle box: a thing containing infinite possibilities, infinite paths, indeed infinite truths.</Text>
        </Row>
        <Row Tag="LOC_10185B_NAME">
            <Text>The truth is what is most dearly believed.</Text>
        </Row>
        <Row Tag="LOC_10185B_DESCRIPTION">
            <Text>{1_reward}.</Text>
        </Row>
        <Row Tag="LOC_10185C_NAME">
            <Text>The truth is what can be agreed upon.</Text>
        </Row>
        <Row Tag="LOC_10185C_DESCRIPTION">
            <Text>{1_reward}.</Text>
        </Row>
        <Row Tag="LOC_10185D_NAME">
            <Text>The truth is what sells.</Text>
        </Row>
        <Row Tag="LOC_10185D_DESCRIPTION">
            <Text>{1_reward}.</Text>
        </Row>
        <Row Tag="LOC_10185E_NAME">
            <Text>The truth is what can be grasped.</Text>
        </Row>
        <Row Tag="LOC_10185E_DESCRIPTION">
            <Text>{1_reward} in {2_capital}.</Text>
        </Row>
        <Row Tag="LOC_10185F_NAME">
            <Text>The truth is what can be enforced.</Text>
        </Row>
        <Row Tag="LOC_10185F_DESCRIPTION">
            <Text>{1_reward} on Line Infantry.</Text>
        </Row>
        <Row Tag="LOC_10185G_NAME">
            <Text>The truth is what can be proven.</Text>
        </Row>
        <Row Tag="LOC_10185G_DESCRIPTION">
            <Text>{1_reward}.</Text>
        </Row>
    </EnglishText>
</Database>
