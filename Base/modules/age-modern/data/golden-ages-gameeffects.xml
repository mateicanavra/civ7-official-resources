<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- Authoritarianism -->
	<Modifier id="MOD_AUTHORITARIANISM_PASSIVE_UNHAPPINESS_MITIGATION" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_YIELDS_PENALTY_PER_HAPPINESS_DEFICIT">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_GOVERNMENT">
            	<Argument name="GovernmentType">GOVERNMENT_AUTHORITARIANISM</Argument>
       		</Requirement>
		</SubjectRequirements>
		<Argument name="Amount">2</Argument>
	</Modifier>
	<Modifier id="MOD_AUTHORITARIANISM_PASSIVE_CONQUEST_YIELDS" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_GOVERNMENT">
            	<Argument name="GovernmentType">GOVERNMENT_AUTHORITARIANISM</Argument>
       		</Requirement>
			<Requirement type="REQUIREMENT_CITY_IS_ORIGINAL_OWNER" inverse="true"/>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_FOOD,YIELD_GOLD</Argument>
		<Argument name="Amount">3</Argument>
		<Argument name="Tooltip">LOC_GOVERNMENT_AUTHORITARIANISM_NAME</Argument>
	</Modifier>
	<Modifier id="MOD_GOLDEN_AGE_AUTHORITARIANISM_UNIT_PRODUCTION" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_UNIT_PRODUCTION">
		<Argument name="UnitCoreClass">CORE_CLASS_MILITARY</Argument>
		<Argument name="Percent">20</Argument>
	</Modifier>
	<Modifier id="MOD_GOLDEN_AGE_AUTHORITARIANISM_WAR_SUPPORT" collection="COLLECTION_OWNER" effect="EFFECT_ADJUST_WAR_SUPPORT_BONUS">
		<Argument name="Amount">2</Argument>
		<Argument name="IsAggressor">true</Argument>
	</Modifier>
