<?xml version="1.0" encoding="utf-8"?>
<Database>
	<EnglishText>
		<!-- Names -->
		<Row Tag="LOC_TREE_TECHS_AQ_NAME">
			<Text>Antiquity Technology</Text>
		</Row>
		<Row Tag="LOC_TECH_AGRICULTURE_NAME">
			<Text>Agriculture</Text>
		</Row>
		<Row Tag="LOC_TECH_AGRICULTURE_QUOTE">
			<Text>"The radiance of the new world came into being bathed in nectar, bathed in love."</Text>
		</Row>
		<Row Tag="LOC_TECH_AGRICULTURE_QUOTE_AUTHOR">
			<Text>Preah Khan Inscription</Text>
		</Row>
		<Row Tag="LOC_TECH_POTTERY_NAME">
			<Text>Pottery</Text>
		</Row>
		<Row Tag="LOC_TECH_POTTERY_QUOTE">
			<Text>"All are made of clay."</Text>
		</Row>
		<Row Tag="LOC_TECH_POTTERY_QUOTE_AUTHOR">
			<Text>Henry Wadsworth Longfellow</Text>
		</Row>
		<Row Tag="LOC_TECH_ANIMAL_HUSBANDRY_NAME">
			<Text>Animal Husbandry</Text>
		</Row>
		<Row Tag="LOC_TECH_ANIMAL_HUSBANDRY_QUOTE">
			<Text>"The caged bird watches butterflies with envy."</Text>
		</Row>
		<Row Tag="LOC_TECH_ANIMAL_HUSBANDRY_QUOTE_AUTHOR">
			<Text>Kobayashi Issa</Text>
		</Row>
		<Row Tag="LOC_TECH_SAILING_NAME">
			<Text>Sailing</Text>
		</Row>
		<Row Tag="LOC_TECH_SAILING_QUOTE">
			<Text>"The fair breeze blew, the white foam flew, the furrow followed free; we were the first that ever burst into that silent sea."</Text>
		</Row>
		<Row Tag="LOC_TECH_SAILING_QUOTE_AUTHOR">
			<Text>Samuel Taylor Coleridge</Text>
		</Row>
		<Row Tag="LOC_TECH_WRITING_NAME">
			<Text>Writing</Text>
		</Row>
		<Row Tag="LOC_TECH_WRITING_QUOTE">
			<Text>"The spoken word conquers all thought, but the written word commands it."</Text>
		</Row>
		<Row Tag="LOC_TECH_WRITING_QUOTE_AUTHOR">
			<Text>Walter Benjamin</Text>
		</Row>
		<Row Tag="LOC_TECH_IRRIGATION_NAME">
			<Text>Irrigation</Text>
		</Row>
		<Row Tag="LOC_TECH_IRRIGATION_QUOTE">
			<Text>"The essence of all beings is the earth; the earth, water; the water, plants; plants, man; and man, speech."</Text>
		</Row>
		<Row Tag="LOC_TECH_IRRIGATION_QUOTE_AUTHOR">
			<Text>The Upanishads</Text>
		</Row>
		<Row Tag="LOC_TECH_MASONRY_NAME">
			<Text>Masonry</Text>
		</Row>
		<Row Tag="LOC_TECH_MASONRY_QUOTE">
			<Text>"He was the first to construct a wall, eighty miles in length, which was to separate the barbarians from the Romans."</Text>
		</Row>
		<Row Tag="LOC_TECH_MASONRY_QUOTE_AUTHOR">
			<Text>Cassius Dio</Text>
		</Row>
		<Row Tag="LOC_TECH_CURRENCY_NAME">
			<Text>Currency</Text>
		</Row>
		<Row Tag="LOC_TECH_CURRENCY_QUOTE">
			<Text>"When I was young I thought that money was the most important thing in life; now that I am old I know that it is."</Text>
		</Row>
		<Row Tag="LOC_TECH_CURRENCY_QUOTE_AUTHOR">
			<Text>Oscar Wilde</Text>
		</Row>
		<Row Tag="LOC_TECH_BRONZE_WORKING_NAME">
			<Text>Bronze Working</Text>
		</Row>
		<Row Tag="LOC_TECH_BRONZE_WORKING_QUOTE">
			<Text>"He heard these horrors and his spirit stirred, and spurred to action, he sheathed his skin in burnished bronze."</Text>
		</Row>
		<Row Tag="LOC_TECH_BRONZE_WORKING_QUOTE_AUTHOR">
			<Text>The Iliad</Text>
		</Row>
		<Row Tag="LOC_TECH_WHEEL_NAME">
			<Text>The Wheel</Text>
		</Row>
		<Row Tag="LOC_TECH_WHEEL_QUOTE">
			<Text>"INVENTOR, n. A person who makes an ingenious arrangement of wheels, levers, and springs, and believes it civilization."</Text>
		</Row>
		<Row Tag="LOC_TECH_WHEEL_QUOTE_AUTHOR">
			<Text>Ambrose Bierce</Text>
		</Row>
		<Row Tag="LOC_TECH_NAVIGATION_NAME">
			<Text>Navigation</Text>
		</Row>
		<Row Tag="LOC_TECH_NAVIGATION_QUOTE">
			<Text>"Ships at a distance have every man's wish on board."</Text>
		</Row>
		<Row Tag="LOC_TECH_NAVIGATION_QUOTE_AUTHOR">
			<Text>Zora Neale Hurston</Text>
		</Row>
		<Row Tag="LOC_TECH_ENGINEERING_NAME">
			<Text>Engineering</Text>
		</Row>
		<Row Tag="LOC_TECH_ENGINEERING_QUOTE">
			<Text>"Perfection is achieved not when there is nothing more to add, but when there is nothing left to take away."</Text>
		</Row>
		<Row Tag="LOC_TECH_ENGINEERING_QUOTE_AUTHOR">
			<Text>Antoine de Saint-Exupéry</Text>
		</Row>
		<Row Tag="LOC_TECH_MILITARY_TRAINING_NAME">
			<Text>Military Training</Text>
		</Row>
		<Row Tag="LOC_TECH_MILITARY_TRAINING_QUOTE">
			<Text>"The truly brave never boast."</Text>
		</Row>
		<Row Tag="LOC_TECH_MILITARY_TRAINING_QUOTE_AUTHOR">
			<Text>The Mahābhārata</Text>
		</Row>
		<Row Tag="LOC_TECH_MATHEMATICS_NAME">
			<Text>Mathematics</Text>
		</Row>
		<Row Tag="LOC_TECH_MATHEMATICS_QUOTE">
			<Text>"There is geometry in the humming of the strings. There is music in the spacing of the spheres."</Text>
		</Row>
		<Row Tag="LOC_TECH_MATHEMATICS_QUOTE_AUTHOR">
			<Text>Pythagoras</Text>
		</Row>
		<Row Tag="LOC_TECH_IRON_WORKING_NAME">
			<Text>Iron Working</Text>
		</Row>
		<Row Tag="LOC_TECH_IRON_WORKING_QUOTE">
			<Text>"Iron made this promise: 'By the tongs and the hammer, many trees I can injure, but I shall not kill the best of heroes.'"</Text>
		</Row>
		<Row Tag="LOC_TECH_IRON_WORKING_QUOTE_AUTHOR">
			<Text>The Kalevala</Text>
		</Row>
		<Row Tag="LOC_TECH_FUTURE_TECH_NAME">
			<Text>Future Tech</Text>
		</Row>
		<Row Tag="LOC_TECH_FUTURE_TECH_QUOTE">
			<Text />
		</Row>
		<Row Tag="LOC_TECH_FUTURE_TECH_AUTHOR">
			<Text />
		</Row>
		<!-- Tech Standard Modifiers -->
		<Row Tag="LOC_MOD_AQ_SETTLEMENT_CAP_INCREASE_DESCRIPTION">
			<Text>+1 [icon:SETTLEMENT_LIMIT] [TIP:LOC_PEDIA_CONCEPTS_SETTLEMENT_LIMIT_TOOLTIP]Settlement Limit[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_SPECIALIST_CAP_INCREASE_DESCRIPTION">
			<Text>+1 [icon:SPECIALIST] [TIP:LOC_PEDIA_CONCEPTS_SPECIALIST_LIMIT_TOOLTIP]Specialist Limit[/TIP] in all [icon:YIELD_CITIES] [TIP:LOC_PEDIA_CONCEPTS_CITIES_TOOLTIP]Cities[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_CODEX_DESCRIPTION">
			<Text>Gain 1 [icon:NAR_REW_GREATWORK] [TIP:LOC_PEDIA_CONCEPTS_CODEX_TOOLTIP]Codex[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_MATHEMATICS_CODEX_DESCRIPTION">
			<Text>Gain 2 [icon:NAR_REW_GREATWORK] [TIP:LOC_PEDIA_CONCEPTS_CODEX_TOOLTIP]Codices[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_WALL_STRENGTH_PREVIEW">
			<Text>+{1_Amount} Masonry</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_WALL_STRENGTH_DESCRIPTION">
			<Text>+3 [icon:NAR_REW_COMBAT] [TIP:LOC_PEDIA_CONCEPTS_COMBAT_STRENGTH_TOOLTIP]Combat Strength[/TIP] for [icon:CITY_FORTIFIED] [TIP:LOC_PEDIA_CONCEPTS_FORTIFIED_DISTRICTS_TOOLTIP]Fortified Districts[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_INFANTRY_STRENGTH_DESCRIPTION">
			<Text>+3 [icon:NAR_REW_COMBAT] [TIP:LOC_PEDIA_CONCEPTS_COMBAT_STRENGTH_TOOLTIP]Combat Strength[/TIP] for [TIP:LOC_PEDIA_CONCEPTS_INFANTRY_UNITS_TOOLTIP]Infantry Units[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_SIEGE_MOVEMENT_DESCRIPTION">
			<Text>+1 [icon:Action_Move] Movement for [TIP:LOC_PEDIA_CONCEPTS_SIEGE_UNITS_TOOLTIP]Siege Units[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_CITY_REOURCE_VP">
			<Text>+1 [icon:ECONOMIC_VP] [TIP:LOC_PEDIA_CONCEPTS_GDP_TOOLTIP]GDP[/TIP] per turn for [icon:RADIAL_RESOURCES] [TIP:LOC_PEDIA_CONCEPTS_RESOURCES_TOOLTIP]Resources[/TIP] assigned to [icon:YIELD_CITIES] [TIP:LOC_PEDIA_CONCEPTS_CITIES_TOOLTIP]Cities[/TIP] (not Towns).</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_UNIQUIE_IMPROVEMENT_TOURISM_DESCRIPTION">
			<Text>+1 [icon:CULTURE_VP] Tourism for each type of Unique Improvement in your Settlements.</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_GOLD_BUILDING_VP">
			<Text>+2 [icon:ECONOMIC_VP] [TIP:LOC_PEDIA_CONCEPTS_GDP_TOOLTIP]GDP[/TIP] per turn from [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Gold Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_SAILING_EMBARKATION_NAME">
			<Text>Embarkation</Text>
		</Row>
		<Row Tag="LOC_MOD_SAILING_EMBARKATION_DESCRIPTION">
			<Text>Allows all standard [TIP:LOC_PEDIA_CONCEPTS_LAND_UNITS_TOOLTIP]Land Units[/TIP] to traverse Coast Terrain.</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_NAVAL_STRENGTH_DESCRIPTION">
			<Text>+3 [icon:NAR_REW_COMBAT] [TIP:LOC_PEDIA_CONCEPTS_COMBAT_STRENGTH_TOOLTIP]Combat Strength[/TIP] for [TIP:LOC_PEDIA_CONCEPTS_NAVAL_UNITS_TOOLTIP]Naval Units[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_UNLOCK_UNIT_FLANKING_DESCRIPTION">
			<Text>Unlocks Unit [TIP:LOC_PEDIA_CONCEPTS_FLANKING_TOOLTIP]Flanking[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_RANGED_STRENGTH_DESCRIPTION">
			<Text>+3 [icon:Action_Ranged] [TIP:LOC_PEDIA_CONCEPTS_COMBAT_STRENGTH_TOOLTIP]Combat Strength[/TIP] for [TIP:LOC_PEDIA_CONCEPTS_RANGED_UNITS_TOOLTIP]Ranged[/TIP] and [TIP:LOC_PEDIA_CONCEPTS_SIEGE_UNITS_TOOLTIP]Siege Units[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_CULTURE_BUILDING_DESCRIPTION">
			<Text>+1 [icon:YIELD_CULTURE] Culture on [icon:YIELD_CULTURE] Culture [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_FOOD_BUILDING_DESCRIPTION">
			<Text>+1 [icon:YIELD_FOOD] Food on [icon:YIELD_FOOD] Food [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_GOLD_BUILDING_DESCRIPTION">
			<Text>+1 [icon:YIELD_GOLD] Gold on [icon:YIELD_GOLD] Gold [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_HAPPINESS_BUILDING_DESCRIPTION">
			<Text>+1 [icon:YIELD_HAPPINESS] Happiness on [icon:YIELD_HAPPINESS] Happiness [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_MILITARY_BUILDING_DESCRIPTION">
			<Text>+2 [icon:YIELD_PRODUCTION] Production on [icon:MILITARY] Military [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_PRODUCTION_BUILDING_DESCRIPTION">
			<Text>+1 [icon:YIELD_PRODUCTION] Production on [icon:YIELD_PRODUCTION] Production [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_TECH_SCIENCE_BUILDING_DESCRIPTION">
			<Text>+1 [icon:YIELD_SCIENCE] Science on [icon:YIELD_SCIENCE] Science [TIP:LOC_PEDIA_CONCEPTS_BUILDINGS_TOOLTIP]Buildings[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_FUTURE_TECH_ATTRIBUTE_DESCRIPTION">
			<Text>+1 [icon:ATTRIBUTE] Random [TIP:LOC_PEDIA_CONCEPTS_ATTRIBUTE_TOOLTIP]Attribute[/TIP] Point.</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_FUTURE_TECH_BOOST_DESCRIPTION">
			<Text>A boost for a starting [icon:RADIAL_TECH] [TIP:LOC_PEDIA_CONCEPTS_TECH_TOOLTIP]Tech[/TIP] in the next [TIP:LOC_PEDIA_CONCEPTS_AGE_TOOLTIP]Age[/TIP].</Text>
		</Row>
		<Row Tag="LOC_MOD_AQ_FUTURE_TECH_AGE_PROGRESS_DESCRIPTION">
			<Text>+10 [icon:NOTIFICATION_TEAM_VICTORIOUS] [TIP:LOC_PEDIA_CONCEPTS_AGE_PROGRESS_TOOLTIP]Age Progress[/TIP].</Text>
		</Row>
		<!-- Tech Improvement Modifiers -->
		<Row Tag="LOC_MOD_TECH_AQ_FLAT_FOOD_DESCRIPTION">
			<Text>+1[icon:YIELD_FOOD] Food on Farms.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_FISHING_BOAT_FOOD_DESCRIPTION">
			<Text>+1[icon:YIELD_FOOD] Food on Fishing Boats.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_PLANTATION_FOOD_DESCRIPTION">
			<Text>+1[icon:YIELD_FOOD] Food on Plantations.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_WET_PRODUCTION_DESCRIPTION">
			<Text>+1[icon:YIELD_PRODUCTION] Production on Clay Pits.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_PASTURE_FOOD_DESCRIPTION">
			<Text>+1[icon:YIELD_FOOD] Food on Pastures.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_CAMP_PRODUCTION_DESCRIPTION">
			<Text>+1[icon:YIELD_PRODUCTION] Production on Camps and Woodcutters.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_MINE_PRODUCTION_DESCRIPTION">
			<Text>+1[icon:YIELD_PRODUCTION] Production on Mines and Quarries.</Text>
		</Row>
		<Row Tag="LOC_MOD_TECH_AQ_TRADE_RANGE">
			<Text>+5 [TIP:LOC_PEDIA_CONCEPTS_TRADE_RANGE_TOOLTIP]Trade Range[/TIP]</Text>
		</Row>
	</EnglishText>
</Database>