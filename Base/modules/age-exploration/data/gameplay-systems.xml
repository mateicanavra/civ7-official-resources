<?xml version="1.0" encoding="utf-8"?>
<Database>
	<Types>
		<Row Type="GAME_SYSTEM_PREREQ_TREASURE_FLEET" Kind="KIND_GAME_SYSTEM_PREREQ" />
	</Types>
	<GameSystemPrereqs>
		<Row GameSystemType="GAME_SYSTEM_PREREQ_TREASURE_FLEET" ResourceClassPrereq="RESOURCECLASS_TREASURE" />
	</GameSystemPrereqs>
	<GlobalParameters>
		<!--Happiness Threshold curve is represented by the polynomial (ax^3 + bx^2 + cx + d)-->
		<!--where x is the Golden Age count whose threshold we are looking for.-->
		<!--I.E. x would be 4 if we were looking for the threshold for the fourth Golden Age.-->
		<Replace name="GOLDEN_AGE_HAPPINESS_CURVE_A" value="2" />
		<Replace name="GOLDEN_AGE_HAPPINESS_CURVE_B" value="560" />
		<Replace name="GOLDEN_AGE_HAPPINESS_CURVE_C" value="280" />
		<Replace name="GOLDEN_AGE_HAPPINESS_CURVE_D" value="175" />

		<Replace name="INDEPENDENT_SPACING" value="6" />
		<Replace name="PLOT_WATER_DAMAGE_BASE" value="11" />
		<Replace name="PLOT_WATER_DAMAGE_RAND" value="10" />
		<Replace name="UNIT_HEAL_NAVAL_SHALLOW_NEUTRAL" value="15" />
		<Replace name="MOVEMENT_WHILE_EMBARKED_BASE" value="2" />

		<Replace name="TOWN_UPGRADE_MAXIMUM_COST" value="3000" />
		<Replace name="TOWN_UPGRADE_PER_CITY_COST" value="700" />
		<Replace name="TOWN_UPGRADE_BASE_COST" value="700" />

		<Replace name="CITY_WORKER_STARTING_CAP" value="1" />

		<Replace name="CITY_RAZE_DISTRICTS_PER_TURN" value="2" />
	</GlobalParameters>
	<WarWearinessEffects> <!-- changed here instead of happiness-identity because we don't use that in age modules -->
		<Update>
			<Where WarWearinessType="WAR_WEARINESS_FOUNDED_SELF"/>
			<Set YieldReductionPerLevel="5"/>
		</Update>
		<Update>
			<Where WarWearinessType="WAR_WEARINESS_FOUNDED_OTHER"/>
			<Set YieldReductionPerLevel="7"/>
		</Update>
		<Update>
			<Where WarWearinessType="WAR_WEARINESS_FOUNDED_WAR_OPPONENT"/>
			<Set YieldReductionPerLevel="9"/>
		</Update>
	</WarWearinessEffects>
	<HappinessStages>
		<Row HappinessStageType="HAPPINESS_STAGE_ECSTATIC" StageMinThreshold="80" Age="AGE_EXPLORATION"/>
		<Row HappinessStageType="HAPPINESS_STAGE_JOYOUS" StageMinThreshold="40" StageMaxThreshold="80" Age="AGE_EXPLORATION"/>
		<Row HappinessStageType="HAPPINESS_STAGE_HAPPY" StageMinThreshold="0" StageMaxThreshold="40" Age="AGE_EXPLORATION"/>
		<Row HappinessStageType="HAPPINESS_STAGE_UNHAPPY"  StageMinThreshold="-20" StageMaxThreshold="0" Age="AGE_EXPLORATION"/>
		<Row HappinessStageType="HAPPINESS_STAGE_ANGRY" StageMaxThreshold="-20" Age="AGE_EXPLORATION"/>
	</HappinessStages>
</Database>