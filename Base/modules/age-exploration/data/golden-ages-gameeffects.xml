		<SubjectRequirements>
			<Requirement type="REQUIREMENT_SETTLEMENT_HAPPINESS_STAGE_MATCHES">
				<Argument name="IsGreaterThanOrEquals">true</Argument>
				<Argument name="HappinessStage">HAPPINESS_STAGE_HAPPY</Argument>
       		</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_CULTURE</Argument>
		<Argument name="Amount">2</Argument>
	</Modifier>
