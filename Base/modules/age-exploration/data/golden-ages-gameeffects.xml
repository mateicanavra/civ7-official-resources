	<Modifier id="MOD_FEUDAL_MONARCHY_PASSIVE_WALLS_PRODUCTION" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_CONSTRUCTIBLE_PRODUCTION">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_GOVERNMENT">
            	<Argument name="GovernmentType">GOVERNMENT_FEUDAL_MONARCHY</Argument>
       		</Requirement>
		</SubjectRequirements>
		<Argument name="ConstructibleType">BUILDING_MEDIEVAL_WALLS</Argument>
		<Argument name="Percent">10</Argument>
	</Modifier>	
